# Production contains only application source, public assets, and install metadata.
# Test runs, saved stories, logs, tools, backups, and local configuration stay local.
*
!api
!api/**
!lib
!lib/**
!config
!config/**
!public
!public/**
!package.json
!package-lock.json
!vercel.json
!.vercelignore

# Local configuration never belongs in the upload, even beneath an allowed folder.
**/.env
**/.env.*
**/*.env
**/*.env.*
**/node_modules/
**/.DS_Store
**/LATEST
api/config.json
api/config.json.save
api/config

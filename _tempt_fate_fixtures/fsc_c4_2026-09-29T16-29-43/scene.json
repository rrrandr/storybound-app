    {"idx": 3, "kind": "narration", "text": "He falters. The word he needs refuses to arrive.", "speaker": null, "tension_state": "tightening", "echo_profile": null, "expression_target": "lips_tighten", "expression_intensity": 0.3, "cut_to_closeup": false, "closeup_target": null, "shot_type": null, "impact_burst": false, "metaphor_hint": null, "metaphor_peak": false, "pc_proxy_action": null, "hand_gesture": null, "posture_change": null},
    {"idx": 4, "kind": "narration", "text": "The assembly shifts. No one speaks the unease aloud.", "speaker": null, "tension_state": "composed", "echo_profile": null, "expression_target": "neutral", "expression_intensity": null, "cut_to_closeup": false, "closeup_target": null, "shot_type": null, "impact_burst": false, "metaphor_hint": null, "metaphor_peak": false, "pc_proxy_action": null, "hand_gesture": null, "posture_change": null},
    {"idx": 5, "kind": "narration", "text": "Julian's gaze finds me before the Dohkar turns.", "speaker": null, "tension_state": "suppressed", "echo_profile": null, "expression_target": "lips_tighten", "expression_intensity": 0.25, "cut_to_closeup": false, "closeup_target": null, "shot_type": null, "impact_burst": false, "metaphor_hint": null, "metaphor_peak": false, "pc_proxy_action": "my hand grips the sash edge", "hand_gesture": null, "posture_change": null},

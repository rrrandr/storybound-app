  "beats": [
    {"idx": 0, "kind": "narration", "text": "The assembly has turned.", "speaker": null, "tension_state": "composed", "echo_profile": null, "expression_target": "neutral", "expression_intensity": null, "cut_to_closeup": false, "closeup_target": null, "shot_type": null, "impact_burst": false, "metaphor_hint": null, "metaphor_peak": false, "pc_proxy_action": null, "hand_gesture": null, "posture_change": null},
    {"idx": 1, "kind": "narration", "text": "Every gaze that should rest on Seren now rests on me.", "speaker": null, "tension_state": "suppressed", "echo_profile": null, "expression_target": "lips_tighten", "expression_intensity": 0.25, "cut_to_closeup": false, "closeup_target": null, "shot_type": null, "impact_burst": false, "metaphor_hint": null, "metaphor_peak": false, "pc_proxy_action": "my hand rises toward the seal then drops", "hand_gesture": null, "posture_change": null},
    {"idx": 2, "kind": "narration", "text": "Seren kneels where she finished her wish, composed as always, yet her brow furrows at her own certainty.", "speaker": null, "tension_state": "composed", "echo_profile": null, "expression_target": "neutral", "expression_intensity": null, "cut_to_closeup": false, "closeup_target": null, "shot_type": null, "impact_burst": false, "metaphor_hint": null, "metaphor_peak": false, "pc_proxy_action": null, "hand_gesture": null, "posture_change": null},
    {"idx": 3, "kind": "narration", "text": "The presiding Dohkar stands at the clearing's edge, suspicion still alive though its cause has slipped from him.", "speaker": null, "tension_state": "composed", "echo_profile": null, "expression_target": "neutral", "expression_intensity": null, "cut_to_closeup": false, "closeup_target": null, "shot_type": null, "impact_burst": false, "metaphor_hint": null, "metaphor_peak": false, "pc_proxy_action": null, "hand_gesture": null, "posture_change": null},
    {"idx": 4, "kind": "narration", "text": "No one names the moment the eyes shifted.", "speaker": null, "tension_state": "suppressed", "echo_profile": null, "expression_target": "jaw_clench", "expression_intensity": 0.3, "cut_to_closeup": false, "closeup_target": null, "shot_type": null, "impact_burst": false, "metaphor_hint": null, "metaphor_peak": false, "pc_proxy_action": null, "hand_gesture": null, "posture_change": null},
    {"idx": 5, "kind": "narration", "text": "Julian stands apart, too still, the scar on his left wrist catching the last light.", "speaker": null, "tension_state": "composed", "echo_profile": null, "expression_target": "neutral", "expression_intensity": null, "cut_to_closeup": false, "closeup_target": null, "shot_type": null, "impact_burst": false, "metaphor_hint": null, "metaphor_peak": false, "pc_proxy_action": null, "hand_gesture": null, "posture_change": null},
    {"idx": 6, "kind": "narration", "text": "His attention lingers on me with no remaining justification he can name.", "speaker": null, "tension_state": "tightening", "echo_profile": null, "expression_target": "jaw_set", "expression_intensity": 0.35, "cut_to_closeup": false, "closeup_target": null, "shot_type": null, "impact_burst": false, "metaphor_hint": null, "metaphor_peak": false, "pc_proxy_action": "the breath catches and holds", "hand_gesture": null, "posture_change": null},
    {"idx": 7, "kind": "narration", "text": "The crimson spiralgrass rustles under the weight of so many bare feet turned the wrong way.", "speaker": null, "tension_state": "composed", "echo_profile": null, "expression_target": "neutral", "expression_intensity": null, "cut_to_closeup": false, "closeup_target": null, "shot_type": null, "impact_burst": false, "metaphor_hint": null, "metaphor_peak": false, "pc_proxy_action": null, "hand_gesture": null, "posture_change": null},
    {"idx": 8, "kind": "narration", "text": "I feel the seal press against my lips as the words I cannot speak press back.", "speaker": null, "tension_state": "suppressed", "echo_profile": "suppressed", "expression_target": "lips_pressed", "expression_intensity": 0.4, "cut_to_closeup": true, "closeup_target": "protagonist", "shot_type": "mouth", "impact_burst": false, "metaphor_hint": null, "metaphor_peak": false, "pc_proxy_action": null, "hand_gesture": null, "posture_change": null},
    {"idx": 9, "kind": "narration", "text": "The Dohkar's voice cuts across the clearing, still demanding an answer though the question has already changed.", "speaker": null, "tension_state": "composed", "echo_profile": null, "expression_target": "neutral", "expression_intensity": null, "cut_to_closeup": false, "closeup_target": null, "shot_type": null, "impact_burst": false, "metaphor_hint": null, "metaphor_peak": false, "pc_proxy_action": null, "hand_gesture": null, "posture_change": null},
    {"idx": 10, "kind": "narration", "text": "Seren's small shoulders remain straight, yet her coral hair trembles once with a frown she cannot hide.", "speaker": null, "tension_state": "composed", "echo_profile": null, "expression_target": "neutral", "expression_intensity": null, "cut_to_closeup": false, "closeup_target": null, "shot_type": null, "impact_burst": false, "metaphor_hint": null, "metaphor_peak": false, "pc_proxy_action": null, "hand_gesture": null, "posture_change": null},
    {"idx": 11, "kind": "narration", "text": "Julian has not moved, yet the weight of his gaze has become the only steady point in the clearing.", "speaker": null, "tension_state": "tightening", "echo_profile": null, "expression_target": "jaw_clench", "expression_intensity": 0.35, "cut_to_closeup": false, "closeup_target": null, "shot_type": null, "impact_burst": false, "metaphor_hint": null, "metaphor_peak": false, "pc_proxy_action": null, "hand_gesture": null, "posture_change": null},
    {"idx": 12, "kind": "narration", "text": "No one can say what pulled every eye toward me.", "speaker": null, "tension_state": "suppressed", "echo_profile": "hollow", "expression_target": "lips_tighten", "expression_intensity": 0.3, "cut_to_closeup": false, "closeup_target": null, "shot_type": null, "impact_burst": false, "metaphor_hint": null, "metaphor_peak": false, "pc_proxy_action": "her index finger pressed flat against the seal and stayed", "hand_gesture": null, "posture_change": null},
    {"idx": 13, "kind": "narration", "text": "The Dohkar repeats the charge of interference, the words now floating without their original anchor.", "speaker": null, "tension_state": "composed", "echo_profile": null, "expression_target": "neutral", "expression_intensity": null, "cut_to_closeup": false, "closeup_target": null, "shot_type": null, "impact_burst": false, "metaphor_hint": null, "metaphor_peak": false, "pc_proxy_action": null, "hand_gesture": null, "posture_change": null},
    {"idx": 14, "kind": "narration", "text": "Seren's mouth opens, then closes, the apology she rehearsed no longer fitting the moment.", "speaker": null, "tension_state": "composed", "echo_profile": null, "expression_target": "neutral", "expression_intensity": null, "cut_to_closeup": false, "closeup_target": null, "shot_type": null, "impact_burst": false, "metaphor_hint": null, "metaphor_peak": false, "pc_proxy_action": null, "hand_gesture": null, "posture_change": null},
    {"idx": 15, "kind": "narration", "text": "Julian's silver Weave-Script shifts once across his slate-blue skin, the only visible sign he still tracks the wrong target.", "speaker": null, "tension_state": "composed", "echo_profile": null, "expression_target": "neutral", "expression_intensity": null, "cut_to_closeup": false, "closeup_target": null, "shot_type": null, "impact_burst": false, "metaphor_hint": null, "metaphor_peak": false, "pc_proxy_action": null, "hand_gesture": null, "posture_change": null},
    {"idx": 16, "kind": "narration", "text": "The clearing holds its breath around the question that now belongs to me.", "speaker": null, "tension_state": "held_breath", "echo_profile": null, "expression_target": "neutral", "expression_intensity": null, "cut_to_closeup": false, "closeup_target": null, "shot_type": null, "impact_burst": false, "metaphor_hint": null, "metaphor_peak": false, "pc_proxy_action": null, "hand_gesture": null, "posture_change": null},
    {"idx": 17, "kind": "narration", "text": "I could speak through the seal, claim the interference openly, end the confusion.", "speaker": null, "tension_state": "tightening", "echo_profile": null, "expression_target": "jaw_set", "expression_intensity": 0.4, "cut_to_closeup": false, "closeup_target": null, "shot_type": null, "impact_burst": false, "metaphor_hint": null, "metaphor_peak": false, "pc_proxy_action": null, "hand_gesture": null, "posture_change": null},
    {"idx": 18, "kind": "narration", "text": "Or I could let the assumption stand and keep what little standing remains to me.", "speaker": null, "tension_state": "suppressed", "echo_profile": null, "expression_target": "lips_pressed", "expression_intensity": 0.35, "cut_to_closeup": false, "closeup_target": null, "shot_type": null, "impact_burst": false, "metaphor_hint": null, "metaphor_peak": false, "pc_proxy_action": "the ring rotated once on her finger", "hand_gesture": null, "posture_change": null},
    {"idx": 19, "kind": "narration", "text": "The cost of either path has not yet been named.", "speaker": null, "tension_state": "cracking", "echo_profile": "rupture", "expression_target": "mouth_parted", "expression_intensity": 0.6, "cut_to_closeup": true, "closeup_target": "protagonist", "shot_type": "face", "impact_burst": true, "metaphor_hint": null, "metaphor_peak": false, "pc_proxy_action": null, "hand_gesture": null, "posture_change": "shoulders_tighten"},
